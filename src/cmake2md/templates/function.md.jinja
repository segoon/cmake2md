{#
  Renders a single function() or macro().

  Used two ways: cmake2md renders it once per symbol to build
  `symbol.pretty`, and it also works as a whole-document template
  (`--template function.md.jinja`), where it documents every documented
  function and macro.
#}
{% macro required(r) %}
{%- if not r %}[{% endif %}
{{- caller() }}
{%- if not r %}]{% endif %}
{%- endmacro -%}

{% macro function(symbol) %}
{%- set has_params = symbol.doc.args or symbol.doc.options
                     or symbol.doc.params or symbol.doc.multi_params %}
## {{ symbol.name }}

{{ symbol.doc.description }}

```
{{ symbol.name }}(
{%- for arg in symbol.doc.args %}
    <{{ arg.name }}>
{%- endfor %}
{%- for arg in symbol.doc.options %}
    {% call required(arg.required) %}{{ arg.name }}{% endcall %}
{%- endfor %}
{%- for arg in symbol.doc.params %}
    {% call required(arg.required) %}{{ arg.name }} <value>{% endcall %}
{%- endfor %}
{%- for arg in symbol.doc.multi_params %}
    {% call required(arg.required) %}{{ arg.name }} <value>...{% endcall %}
{%- endfor %}
{%- if has_params %}
{% endif %})
```
{% for arg in symbol.doc.args %}
* <**{{ arg.name }}**> {{ arg.description }}
{%- endfor %}
{%- for arg in symbol.doc.options %}
* **{{ arg.name }}** {{ arg.description }}
{%- endfor %}
{%- for arg in symbol.doc.params %}
* **{{ arg.name }} <value>** {{ arg.description }}
{%- endfor %}
{%- for arg in symbol.doc.multi_params %}
* **{{ arg.name }} <value>...** {{ arg.description }}
{%- endfor %}
{%- endmacro -%}

{% if symbol is defined %}
{{- function(symbol) }}
{%- else %}
{%- for symbol in symbols | documented %}
{{ function(symbol) }}
{%- endfor %}
{%- endif %}
