{#
  Renders a single function() or macro().

  Rendered with `symbol` set, this fills that symbol's `pretty` field; without
  it, the same file serves as a whole document. Hence the dispatch at the
  bottom, and the body living in a macro so both paths can share it.
#}
{% macro required(r) %}
{%- if not r %}[{% endif %}
{{- caller() }}
{%- if not r %}]{% endif %}
{%- endmacro -%}

{% macro about(arg) %}
{%- if arg.type_ or arg.default %} ({% if arg.type_ %}{{ arg.type_ }}
{%- endif %}{% if arg.type_ and arg.default %}, {% endif %}
{%- if arg.default %}default `{{ arg.default }}`{% endif %}){% endif %}
{%- endmacro %}

{#
  A @note or a @warning stands out as a blockquote; every line of it needs the
  marker, hence the replace().
#}
{% macro quoted(label, text) %}
> **{{ label }}** {{ text | replace('\n', '\n> ') }}
{% endmacro %}

{#
  Kinds rendered some other way below, so `other_sections` must not render
  them a second time: @example as a code fence, @since as a sentence, @see as
  a linked list, @defgroup as a group of its own rather than a symbol's
  section. Not @brief: it never appears in doc.sections, @brief opens
  doc.brief instead. @note, @warning and @todo need no entry here — they read
  the same as any tag a project declares itself, `> **{{ label }}** …`, and
  their label already says 'Note:'/'Warning:'/'TODO:' without the template
  naming them.
#}
{% set rendered_kinds = ['example', 'since', 'see', 'defgroup'] %}
{% macro other_sections(doc) %}
{%- for section in doc.sections if section.kind not in rendered_kinds %}
{{ quoted(section.label, section.text) }}
{%- endfor %}
{%- endmacro %}

{% macro function(symbol) %}
{%- set has_params = symbol.doc.args or symbol.doc.options
                     or symbol.doc.params or symbol.doc.multi_params %}
## {{ symbol.name }}
{% if symbol.doc.deprecated %}
**Deprecated.**
{% endif %}
{%- if symbol.doc.brief %}
{{ symbol.doc.brief }}
{% endif %}
{{ symbol.doc.description }}

```
{{ symbol.name }}(
{%- for arg in symbol.doc.args %}
    <{{ arg.name }}>
{%- endfor %}
{%- for arg in symbol.doc.options %}
    {% call required(arg.required) %}{{ arg.name }}{% endcall %}
{%- endfor %}
{%- for arg in symbol.doc.params %}
    {% call required(arg.required) %}{{ arg.name }} <value>{% endcall %}
{%- endfor %}
{%- for arg in symbol.doc.multi_params %}
    {% call required(arg.required) %}{{ arg.name }} <value>...{% endcall %}
{%- endfor %}
{%- if has_params %}
{% endif %})
```
{% for arg in symbol.doc.args %}
* <**{{ arg.name }}**>{{ about(arg) }} {{ arg.description }}
{%- endfor %}
{%- for arg in symbol.doc.options %}
* **{{ arg.name }}**{{ about(arg) }} {{ arg.description }}
{%- endfor %}
{%- for arg in symbol.doc.params %}
* **{{ arg.name }} <value>**{{ about(arg) }} {{ arg.description }}
{%- endfor %}
{%- for arg in symbol.doc.multi_params %}
* **{{ arg.name }} <value>...**{{ about(arg) }} {{ arg.description }}
{%- endfor %}
{% if symbol.doc.returns %}
Sets in the caller's scope:
{% for arg in symbol.doc.returns %}
* **{{ arg.name }}**{{ about(arg) }} {{ arg.description }}
{%- endfor %}
{%- endif %}
{%- for example in symbol.doc.of_kind('example') %}

{% if '```' in example.text %}{{ example.text }}{% else %}```cmake
{{ example.text }}
```{% endif %}
{%- endfor %}
{%- for section in symbol.doc.of_kind('since') %}
*Since {{ section.text }}.*
{% endfor %}
{%- if symbol.doc.of_kind('see') %}
See also: {{ symbol.doc.of_kind('see') | map(attribute='text')
                   | map('symbol_link', symbols | default([])) | join(', ') }}
{% endif %}
{{ other_sections(symbol.doc) }}
{%- endmacro -%}

{% if symbol is defined %}
{{- function(symbol) }}
{%- else %}
{%- for symbol in symbols | documented | public %}
{{ function(symbol) }}
{%- endfor %}
{%- endif %}
